PORT=4000
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d
ADMIN_EMAIL=rantu@admin.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Rantu
# Optional: Firebase Cloud Messaging server key for real push to Admin App.
# When empty, new-payment events are stored as notifications and logged only.
FCM_SERVER_KEY=
# --- MongoDB (set MONGODB_URI to store data in MongoDB; empty = local db.json) ---
MONGODB_URI=
MONGO_DB_NAME=otpdb
# --- Server ---
PUBLIC_BASE_URL=http://localhost:4000
# --- Keep-alive pinger (Render free tier sleeps after ~15 min idle) ---
# Public URL of the deployed backend that the pinger hits (GET /api/health).
# INTERVAL: ping every N minutes — default 7. Change 7 -> 10 for 10 minutes.
KEEPALIVE_URL=
KEEPALIVE_INTERVAL_MINUTES=7
KEEPALIVE_TIMEOUT_MS=15000
# Attempts per keepalive run (a sleeping Render service needs 30-60s to
# cold-start: attempt 1 wakes it, a retry lands once warm).
KEEPALIVE_RETRIES=4
KEEPALIVE_RETRY_WAIT_MS=20000
# Interval for the Render Cron Job lives in `render.yaml` (`schedule:` line).
# RENDER_GIT_COMMIT/BRANCH/SERVICE are set automatically by Render and shown
# in GET /api/health so you can confirm which commit is actually deployed.
# Comma-separated exact origins allowed for CORS (empty = allow all, dev default).
# Production example: CORS_ORIGIN=https://otp.rantumondal.dev,https://admin.rantumondal.dev
CORS_ORIGIN=
# --- Rate limiting (requests per window, per IP) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=100
# --- Profit sharing (percent, must total 100) ---
PROFIT_ALAMIN_PCT=20
PROFIT_RANTU_PCT=40
PROFIT_RONY_PCT=40
# --- Withdrawal contact numbers (shown in Admin profit/withdrawal UI) ---
WITHDRAW_ALAMIN_PHONE=
WITHDRAW_RANTU_PHONE=
WITHDRAW_RONY_PHONE=
# --- bKash receiver phone (Recive payment app) ---
# Shared secret sent as `x-api-key` header on POST /api/received-payments.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECV_API_KEY=
